STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend
# Stripe — leave BLANK to keep the manual/system provider (no real charge).
# Set both to enable Stripe (see STRIPE.md). Provider id once enabled: pp_stripe_stripe.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Email — booking confirmations are sent over SMTP (src/modules/smtp-notification)
# when SMTP_HOST is set; otherwise they are only logged. Use the same values as
# the storefront .env.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
# Farm copy of every activity/workshop booking; comma-separate several addresses
# (defaults to info@orosmaxaira.com).
BOOKING_ADMIN_EMAIL=

# Storefront — its origin (media library, cache revalidation) and the secret its
# /api/revalidate route expects. Use the SAME REVALIDATION_SECRET as the
# storefront .env, so a publish in the content admin shows on the site at once.
STOREFRONT_URL=http://localhost:3002
REVALIDATION_SECRET=

# Uploads — leave S3_BUCKET blank to keep files in ./static (dev only: Railway
# wipes it on redeploy). For Cloudflare R2: S3_ENDPOINT is the account's
# https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto, and
# S3_FILE_URL the bucket's public URL (e.g. https://media.orosmaxaira.com).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FILE_URL=
